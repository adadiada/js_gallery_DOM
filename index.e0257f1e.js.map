"use strict";
var gallery = document.querySelector(".gallery");
var largeImg = document.querySelector("#largeImg");
gallery.addEventListener("click", function(e) {
    var link = e.target.closest("a");
    if (!link) return;
    e.preventDefault();
    var bigSrc = link.href || link.dataset.preview;
    largeImg.src = bigSrc;
});

